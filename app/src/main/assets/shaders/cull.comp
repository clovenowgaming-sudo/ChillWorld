#version 310 es
precision highp float;
precision highp int;

// Culling instance pohon/rumput di GPU (hanya dipakai kalau GLES >= 3.1).
// Hasilnya dipadatkan ke SSBO tujuan + counter di buffer indirect command.
// Aturan tesnya SAMA dengan jalur CPU (InstanceCuller.kt) supaya tampilan identik.
layout(local_size_x = 64) in;

struct Inst {
    vec4 a;   // xyz posisi, w skala
    vec4 b;   // yaw, jenis, seed, radius
};

layout(std430, binding = 0) readonly buffer Src { Inst src[]; };
layout(std430, binding = 1) writeonly buffer Dst { Inst dst[]; };
layout(std430, binding = 2) buffer Cmd {
    uint count;
    uint instanceCount;
    uint firstIndex;
    uint baseVertex;
    uint baseInstance;
};

uniform vec4 uPlanes[6];
uniform vec4 uCam;       // xyz = posisi kamera
uniform vec4 uRange;     // x = jarak min, y = jarak max, z = filter jenis (-1 = semua), w = kapasitas
uniform uint uCount;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uCount) return;
    Inst s = src[i];
    if (uRange.z >= 0.0 && abs(s.b.y - uRange.z) > 0.5) return;
    float r = s.b.w;
    vec3 c = s.a.xyz + vec3(0.0, r * 0.5, 0.0);
    float d = distance(c, uCam.xyz);
    if (d < uRange.x || d >= uRange.y) return;
    for (int k = 0; k < 6; k++) {
        if (dot(uPlanes[k].xyz, c) + uPlanes[k].w < -r) return;
    }
    uint idx = atomicAdd(instanceCount, 1u);
    if (float(idx) < uRange.w) dst[idx] = s;
}
